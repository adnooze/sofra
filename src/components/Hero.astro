---
import { Image } from 'astro:assets';
import mixPlata from '../assets/ig/mix-plata.jpg';
import keteringZeda from '../assets/ig/ketering-zeda.jpg';
import slatkiKetering from '../assets/ig/slatki-ketering.jpg';

const slides = [
  { src: mixPlata, alt: 'Mix plata s mini sendvičima, kroasanima i suhim mesom', position: '50% 55%' },
  { src: keteringZeda, alt: 'Ketering stol prepun slanih i slatkih zalogaja', position: '50% 45%' },
  { src: slatkiKetering, alt: 'Slatke čašice s kremom i šumskim voćem', position: '50% 60%' },
];
---

<section class="hero" id="pocetna" data-hero>
  <div class="hero__media" aria-hidden="true">
    {
      slides.map((s, i) => (
        <Image
          src={s.src}
          alt={s.alt}
          widths={[800, 1200, 1800]}
          sizes="(max-width: 900px) 100vw, 65vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          class:list={['hero__slide', { 'is-active': i === 0 }]}
          style={`object-position: ${s.position}`}
          data-slide
        />
      ))
    }
  </div>

  <div class="hero__content wrap">
    <span class="eyebrow hero__eyebrow">Svježe iz naše pekare · Zenica</span>
    <h1>Pripremljeno<br />da vas<br />obraduje.</h1>
    <p class="hero__lead">
      Radimo sve vrste keteringa po vašoj želji — od mix plata i slanih zalogaja do kolača i slatkih stolova, svježe
      pripremljenih za svaku priliku.
    </p>
    <div class="hero__actions">
      <a href="#ponuda" class="btn btn--solid">Pogledaj ponudu</a>
      <a href="#prica" class="btn btn--ghost-light">Upoznaj Sofru</a>
    </div>
  </div>

  <div class="hero__dots" role="tablist" aria-label="Slike">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class:list={['dot', { 'is-active': i === 0 }]}
          aria-label={`Slika ${i + 1}`}
          data-dot={i}
        />
      ))
    }
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
  const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
  let current = 0;
  let timer: number | undefined;

  const show = (i: number) => {
    slides[current].classList.remove('is-active');
    dots[current].classList.remove('is-active');
    current = (i + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    dots[current].classList.add('is-active');
  };

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = () => {
    if (reduced) return;
    window.clearInterval(timer);
    timer = window.setInterval(() => show(current + 1), 6000);
  };

  dots.forEach((d, i) =>
    d.addEventListener('click', () => {
      show(i);
      start();
    }),
  );
  start();
</script>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 820px);
    background: radial-gradient(120% 90% at 70% 40%, #2c1e15 0%, var(--espresso) 60%);
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 64%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 38%);
    mask-image: linear-gradient(to right, transparent 0%, #000 38%);
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(27, 19, 14, 0.75), transparent 35%),
      linear-gradient(to bottom, rgba(27, 19, 14, 0.55), transparent 25%);
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 1.2s ease,
      transform 7s ease-out;
  }
  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: 120px;
    padding-bottom: 96px;
  }
  .hero__eyebrow {
    color: var(--tan);
    margin-bottom: 22px;
  }
  .hero h1 {
    font-size: clamp(44px, 6.2vw, 84px);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    max-width: 9ch;
  }
  .hero__lead {
    margin-top: 26px;
    max-width: 380px;
    font-size: 15px;
    color: rgba(247, 240, 231, 0.82);
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__dots {
    position: absolute;
    z-index: 3;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
  }
  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 99px;
    border: 1px solid rgba(247, 240, 231, 0.7);
    background: transparent;
    cursor: pointer;
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }
  .dot.is-active {
    width: 26px;
    background: var(--cream);
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-end;
      min-height: 100svh;
    }
    .hero__media {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__media::after {
      background: linear-gradient(to top, var(--espresso) 18%, rgba(27, 19, 14, 0.55) 55%, rgba(27, 19, 14, 0.35));
    }
    .hero__content {
      padding-bottom: 80px;
    }
  }
</style>
