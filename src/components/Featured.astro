---
import { Image } from 'astro:assets';
import { posts, site } from '../data/site';
import mixPlata from '../assets/ig/mix-plata.jpg';
import slatki from '../assets/ig/slatki-ketering.jpg';
import fingerfood from '../assets/ig/fingerfood.jpg';
import palacinke from '../assets/ig/palacinke.jpg';
import zeda from '../assets/ig/ketering-zeda.jpg';

const products = [
  {
    title: 'Mix plata 1 & 2',
    note: 'Mini sendviči, kroasani, suho meso i sir',
    price: '55 KM',
    img: mixPlata,
    pos: '50% 60%',
    href: posts.katalog,
  },
  {
    title: 'Plata s američkim palačinkama',
    note: 'Voće ili bombone, slovo ili broj po želji',
    img: palacinke,
    pos: '50% 88%',
    href: posts.palacinke,
  },
  {
    title: 'Slatke čašice',
    note: 'Krem deserti sa šumskim voćem',
    img: slatki,
    pos: '50% 70%',
    href: posts.slatkiKetering,
  },
  {
    title: 'Fingerfood zalogaji',
    note: 'Kremšnite-rolice, kokos kuglice, brownie',
    img: fingerfood,
    pos: '50% 78%',
    href: posts.fingerfood,
  },
  {
    title: 'Ketering stol',
    note: 'Slano i slatko za vaš događaj',
    img: zeda,
    pos: '50% 40%',
    href: posts.zeda,
  },
];
---

<section class="featured" id="ponuda">
  <div class="wrap">
    <div class="featured__head">
      <div>
        <span class="eyebrow">Iz naše ponude</span>
        <h2>Svježe. Domaće. Neodoljivo.</h2>
      </div>
      <a href="#cjenovnik" class="btn btn--ghost-dark">Pogledaj cjenovnik</a>
    </div>

    <ul class="grid">
      {
        products.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener" class="card">
              <span class="card__img">
                <Image
                  src={p.img}
                  alt={p.title}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 600px) 70vw, (max-width: 1100px) 34vw, 240px"
                  style={`object-position: ${p.pos}`}
                />
              </span>
              <span class="card__body">
                <span class="card__title">{p.title}</span>
                <span class="card__note">{p.note}</span>
                {p.price && <span class="card__price">{p.price}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="featured__foot">
      Narudžbe primamo putem poruke na Instagramu ili na broj{' '}<a href={site.phoneHref}>{site.phone}</a>.
    </p>
  </div>
</section>

<style>
  .featured {
    background: var(--paper);
    padding: 96px 0 88px;
  }
  .featured__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .featured h2 {
    margin-top: 12px;
    font-size: clamp(30px, 3.4vw, 44px);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 40px -24px rgba(74, 51, 38, 0.5);
  }
  .card__img {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--cream-2);
  }
  .card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .card:hover .card__img img {
    transform: scale(1.05);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 16px 18px;
    flex: 1;
  }
  .card__title {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.3;
    color: var(--ink);
  }
  .card__note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }
  .card__price {
    margin-top: auto;
    padding-top: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--brown);
  }

  .featured__foot {
    margin-top: 36px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
  }
  .featured__foot a {
    color: var(--brown);
    font-weight: 500;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 700px) {
    .featured {
      padding: 72px 0;
    }
    .featured__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .grid {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 70%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 12px;
      scroll-padding: var(--gutter);
    }
    .grid li {
      scroll-snap-align: start;
    }
  }
</style>
