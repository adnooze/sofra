---
import { Image } from 'astro:assets';
import { highlights } from '../data/site';
import plate from '../assets/ig/hl-plate.jpg';
import kolaci from '../assets/ig/hl-kolaci.jpg';
import ketering from '../assets/ig/hl-ketering.jpg';
import pizza from '../assets/ig/hl-pizza.jpg';
import ponuda from '../assets/ig/hl-ponuda.jpg';
import sokovi from '../assets/ig/hl-sokovi.jpg';

const items = [
  { title: 'Mix plate', img: plate, href: highlights.plate },
  { title: 'Kolači & peciva', img: kolaci, href: highlights.kolaci },
  { title: 'Ketering', img: ketering, href: highlights.ketering },
  { title: 'Pizza', img: pizza, href: highlights.pizza },
  { title: 'Sendviči', img: ponuda, href: highlights.ponuda },
  { title: 'Prirodni sokovi', img: sokovi, href: highlights.sokovi },
];
---

<section class="cats" id="kategorije" aria-label="Kategorije">
  <ul class="cats__list wrap">
    {
      items.map((it) => (
        <li>
          <a href={it.href} target="_blank" rel="noopener" class="cat">
            <span class="cat__img">
              <Image src={it.img} alt="" width={150} height={150} />
            </span>
            <span class="cat__title">{it.title}</span>
            <span class="cat__more">Pogledaj</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cats {
    background: var(--cream);
    padding: 56px 0 50px;
  }
  .cats__list {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
  }
  .cat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cat__img {
    width: 118px;
    height: 118px;
    border-radius: 50%;
    padding: 5px;
    background: var(--paper);
    box-shadow: 0 14px 28px -16px rgba(74, 51, 38, 0.45);
    transition: transform 0.35s ease;
  }
  .cat__img img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .cat:hover .cat__img {
    transform: translateY(-4px);
  }
  .cat__title {
    margin-top: 20px;
    font-family: var(--serif);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .cat__more {
    margin-top: 6px;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .cat:hover .cat__more {
    border-color: var(--muted);
  }

  @media (max-width: 900px) {
    .cats__list {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 36px;
    }
  }
  @media (max-width: 480px) {
    .cats {
      padding: 40px 0;
    }
    .cats__list {
      gap: 14px;
      row-gap: 28px;
    }
    .cat__img {
      width: 92px;
      height: 92px;
    }
    .cat__title {
      font-size: 11px;
      letter-spacing: 0.1em;
    }
  }
</style>
